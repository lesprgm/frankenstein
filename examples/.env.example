# =============================================================================
# LLM Provider Configuration
# =============================================================================

# OpenRouter API Configuration (RECOMMENDED)
# Get your API key from: https://openrouter.ai/keys
# Available models: anthropic/claude-haiku-4.5, openai/gpt-4o, google/gemini-2.0-flash-exp
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# OpenAI API Configuration (optional)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# Gemini API Configuration (optional)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash-exp

# Anthropic API Configuration (optional)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# =============================================================================
# Database Configuration (Required for Storage & Context Engine)
# =============================================================================

# PostgreSQL Database
# For local development, you can use Docker:
# docker run -d --name memorylayer-postgres -p 5432:5432 \
#   -e POSTGRES_PASSWORD=memorylayer -e POSTGRES_DB=memorylayer postgres:15

DATABASE_URL=postgresql://postgres:memorylayer@localhost:5432/memorylayer

# Cloudflare D1 (optional - for production)
# D1_DATABASE_ID=your-d1-database-id
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token

# =============================================================================
# Embedding Provider Configuration (Required for Context Engine)
# =============================================================================

# OpenRouter Embeddings (RECOMMENDED - Uses same API key as above)
# OpenRouter supports OpenAI's embedding models
EMBEDDING_PROVIDER=openrouter
EMBEDDING_API_KEY=your-openrouter-api-key-here
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

# Alternative Options:
# ─────────────────────────────────────────────────────────────────────────

# Option 2: Direct OpenAI (if you have separate OpenAI key)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-your-openai-key-here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Option 3: Cloudflare Vectorize (for production)
# EMBEDDING_PROVIDER=vectorize
# VECTORIZE_INDEX_NAME=memorylayer-embeddings
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token

# Option 4: Local Embeddings (free, for testing)
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384

# =============================================================================
# Context Engine Configuration (Optional)
# =============================================================================

# Maximum tokens to include in context
MAX_CONTEXT_TOKENS=2000

# Minimum relevance score for memories (0-1)
MIN_RELEVANCE_SCORE=0.3

# Maximum number of memories to retrieve
MAX_MEMORIES=10

# Enable conversation history in context
INCLUDE_CONVERSATION_HISTORY=true
